# Copy this file to judge0.conf before starting the project.
# Keep judge0.conf private: it contains local passwords and is ignored by Git.

JUDGE0_TELEMETRY_ENABLE=
ENABLE_WAIT_RESULT=

REDIS_HOST=redis
REDIS_PORT=
REDIS_PASSWORD=replace-with-a-local-redis-password

POSTGRES_HOST=db
POSTGRES_PORT=
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Use a long random value in a real deployment.
SECRET_KEY_BASE=replace-with-a-long-random-secret
